# Marsaly backend environment template — copy to .env and adjust.
APP_NAME=Marsaly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marsaly
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Laravel Reverb (real-time) — php artisan reverb:start
REVERB_APP_ID=marsaly
REVERB_APP_SECRET=marsaly_secret
REVERB_APP_KEY=marsaly_key
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Firebase Cloud Messaging (push). Leave empty in dev -> pushes are logged only.
FCM_PROJECT_ID=
FIREBASE_CREDENTIALS=

# SMS/OTP provider: log|twilio   (log driver prints the code to laravel.log)
MARSALY_SMS_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Marsaly business rules (defaults; also editable from the admin panel)
MARSALY_BASE_DELIVERY_FEE=10.0
MARSALY_PER_KM_FEE=2.5
MARSALY_MIN_ORDER=30.0
MARSALY_DEFAULT_COMMISSION=15
MARSALY_DRIVER_FEE=10
MARSALY_OFFER_TIMEOUT=45
MARSALY_ASSIGN_RADIUS_KM=8.0

# Filament admin brand
FILAMENT_ADMIN_TITLE="Marsaly Admin"
